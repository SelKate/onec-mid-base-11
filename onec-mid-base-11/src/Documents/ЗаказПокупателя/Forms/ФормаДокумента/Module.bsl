#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//++ Селезнева удалена строка с расчетом суммы, добавлен расчет с учтом обоих скидок   10.08.2026
	
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;

	Если Не ПроверитьСогласованнуюСкидку(ТекущиеДанные) Тогда  
		ТекущиеДанные.Сумма = 0;
		Возврат;
	КонецЕсли;
	СуммаСкидок = Объект.ДЗ_СогласованнаяСкидка + ТекущиеДанные.Скидка;
	ТекущиеДанные.Сумма = (ТекущиеДанные.Цена * ТекущиеДанные.Количество) - (ТекущиеДанные.Цена * ТекущиеДанные.Количество) * (СуммаСкидок / 100);
	РассчитатьСуммуДокумента(); 
	//--      	
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

