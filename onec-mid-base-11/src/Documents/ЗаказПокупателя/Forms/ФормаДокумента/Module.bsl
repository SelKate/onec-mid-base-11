
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	// ++ Селезнева добавление рекизита скидка и кнопки пересчитать 31.10.2026 
	
	ПолеВвода = Элементы.Вставить("ДЗ_СогласованнаяСкидка", Тип("ПолеФормы"), Элементы.Страницы.Родитель, Элементы.Страницы);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода; 
	ПолеВвода.ПутьКДанным = "Объект.ДЗ_СогласованнаяСкидка"; 
	ПолеВвода.УстановитьДействие("ПриИзменении", "ПриИзмененииСогласованнойСкидки");
	
	Команда = Команды.Добавить("ПересчитатьТаблицы");
	Команда.Заголовок = "Пересчитать таблицы";
	Команда.Действие = "КомандаПересчитатьТаблицы";
	
	КнопкаФормы = Элементы.Вставить("КнопкаПересчитатьТаблицы", Тип("КнопкаФормы"), Элементы.Страницы.Родитель, Элементы.Страницы);
	КнопкаФормы.ИмяКоманды = "ПересчитатьТаблицы";
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;  
	//--
КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьТаблицы (Команда)
	// ++ Селезнева добавление пересчета 24.07.2026
	ПересчитатьВсеСтроки();	
	//-- 
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВсеСтроки()
	//++ Селезнева пересчет строк с учетом скидки 24.07.2026	

	Для Каждого ТекущиеДанные Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(ТекущиеДанные);
	КонецЦикла; 
	Для Каждого ТекущиеДанные Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(ТекущиеДанные); 
	КонецЦикла;
	//--
КонецПроцедуры 

&НаКлиенте
Асинх Процедура ПриИзмененииСогласованнойСкидки(Элемент)
	//++ Селезнева вопрос пользователю о необходимости пересчета 24.07.2026
	
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Вопрос = ВопросАсинх("Пересчитать табличные части с учетом новой скидки?",РежимДиалогаВопрос.ДаНет);  
	
	ОтветНаВопрос = Ждать Вопрос;
	
	Если ОтветНаВопрос <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьВсеСтроки();
	//-- 
КонецПроцедуры

&НаКлиенте
Функция ПроверитьСогласованнуюСкидку(ТекущиеДанные)  
	//++ Селезнева проверка корректности скидки 10.08.2026
		СуммаСкидок = Объект.ДЗ_СогласованнаяСкидка + ТекущиеДанные.Скидка;
		Если СуммаСкидок > 100 Тогда
			Сообщить("Сумма скидок не может быть больше 100%");
			Возврат Ложь;
		КонецЕсли;	
	Возврат Истина;	
	//-- 
КонецФункции

